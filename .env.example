# URL pública definitiva, sin barra final.
NEXT_PUBLIC_SITE_URL=https://www.bpmtechstudio.com

# Formulario de contacto (servidor).
RESEND_API_KEY=
CONTACT_EMAIL=bpmtechstudio@gmail.com
# Remitente de un dominio verificado en Resend; no usar la dirección @gmail.com.
# Vacío usa onboarding@resend.dev, solo para pruebas al correo de la cuenta Resend.
CONTACT_FROM=

# Diagnóstico en directo (servidor). Sin clave, la web usa la plantilla por palabras clave.
ANTHROPIC_API_KEY=
# Opcional: modelo de la API de Anthropic. Por defecto claude-opus-5.
ANTHROPIC_MODEL=
